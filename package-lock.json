{
  "name": "zcode-agent-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "zcode-agent-workspace",
      "workspaces": [
        "packages/engine",
        "packages/cli"
      ],
      "engines": {
        "node": ">=22.13"
      }
    },
    "node_modules/@zcode-agent/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/zcode-agent": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "zcode-agent",
      "version": "1.3.1",
      "license": "MIT",
      "dependencies": {
        "@zcode-agent/engine": "0.16.9"
      },
      "bin": {
        "zcode-agent": "bin/zcode-agent.js",
        "zcode-agent-acp": "bin/zcode-agent-acp.js"
      },
      "engines": {
        "node": ">=22.13"
      }
    },
    "packages/engine": {
      "name": "@zcode-agent/engine",
      "version": "0.16.9",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=22.13"
      }
    }
  }
}
